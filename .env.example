# ================================
# PayPal Payments (PPCP) 凭证
# ================================
# sandbox 和 production 使用完全独立的 client_id / client_secret
# 切环境时：改 PPCP_USE_SANDBOX 开关 + 替换下面两个值
# 真实凭证一律保管在本地 .env（已被 .gitignore 忽略），禁止提交到 git
# 复制本文件为 .env 后填入真实值再运行 docker compose up -d --force-recreate

# sandbox 阶段：去 https://developer.paypal.com/dashboard/accounts/ 创建 Sandbox Business Account
PPCP_USE_SANDBOX=true
PPCP_CLIENT_ID=your_sandbox_client_id_here
PPCP_CLIENT_SECRET=your_sandbox_client_secret_here
PPCP_MERCHANT_EMAIL=your_sandbox_business_email
PPCP_MERCHANT_ID=your_sandbox_merchant_id
PPCP_MERCHANT_COUNTRY=US

# production 阶段（客户开通真实商户号后启用）：
# PPCP_USE_SANDBOX=false
# PPCP_CLIENT_ID=your_production_client_id
# PPCP_CLIENT_SECRET=your_production_client_secret
# PPCP_MERCHANT_EMAIL=your_production_business_email
# PPCP_MERCHANT_ID=your_production_merchant_id
# PPCP_MERCHANT_COUNTRY=US

# ================================
# WordPress 基础
# ================================
WORDPRESS_DEBUG=false
WP_HOME=https://velore.com
WP_SITEURL=https://velore.com
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=wordpress
